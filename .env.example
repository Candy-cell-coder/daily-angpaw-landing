# ============================================================
# Daily Angpaw Landing Page — Environment Variables
# ------------------------------------------------------------
# Copy this file to ".env.local" and fill in your real values.
# All variables are PUBLIC (NEXT_PUBLIC_) because they are used
# in the browser. Do NOT put secret keys here.
# ============================================================

# Where the "JOIN TELEGRAM" button sends people.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/YourTelegramChannel

# Where the "REGISTER NOW" button sends people.
NEXT_PUBLIC_REGISTER_URL=https://your-register-link.com

# Default campaign source, used when the visitor arrives WITHOUT a ?c= tag.
# Example: FB-LP-1
NEXT_PUBLIC_CAMPAIGN_SOURCE=FB-LP-1

# Meta (Facebook) Pixel ID. Leave EMPTY to disable the pixel safely.
# The page still works perfectly with no Pixel ID set.
NEXT_PUBLIC_META_PIXEL_ID=
